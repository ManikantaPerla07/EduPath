# Example only. Replace placeholders with your own credentials.
# Never commit your populated .streamlit/secrets.toml file.

DATABASE_URL = "YOUR_NEON_POSTGRESQL_CONNECTION_STRING"
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"

[auth]
# For local development. Change this to your deployed callback URL on hosting.
redirect_uri = "http://localhost:8501/oauth2callback"

# Generate a strong random value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "GENERATE_A_LONG_RANDOM_SECRET"

client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
